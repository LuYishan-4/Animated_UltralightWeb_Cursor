import QtQuick.Layouts
ApplicationWindow { visible: true; width: 800; height: 600; title: qsTr("Ultralight Web Cursor - Settings") ColumnLayout { anchors.fill: parent; spacing: 12 RowLayout { Layout.fillWidth: true; Label { text: qsTr("Ultralight Web Cursor") ; font.pixelSize: 20 } Button { text: qsTr("GitHub"); onClicked: Qt.openUrlExternally("https://github.com/LuYishan-4/Animated_UltralightWeb_Cursor") } } TabBar { id: tabBar; Layout.fillWidth: true; TabButton { text: qsTr("Theme") } TabButton { text: qsTr("Blacklist") } TabButton { text: qsTr("Setting") } } StackLayout { Layout.fillWidth: true; Layout.fillHeight: true; currentIndex: tabBar.currentIndex ColumnLayout { ComboBox { id: themeBox; model: backend.themeList; currentIndex: backend.themeList.indexOf(backend.currentTheme); onActivated: backend.useTheme(currentText) } ListView { model: backend.themeList; delegate: Text { text: modelData } } Button { text: qsTr("Upload Theme"); onClicked: { } } } ColumnLayout { ListView { model: backend.blacklist; delegate: RowLayout { Label { text: modelData } Button { text: qsTr("Remove"); onClicked: backend.removeBlacklist(modelData) } } } RowLayout { TextField { id: bl; placeholderText: qsTr("Application name") } Button { text: qsTr("Add"); onClicked: backend.addBlacklist(bl.text) } } } ColumnLayout { SpinBox { value: backend.cursorWidth; onValueChanged: backend.setCursorWidth(value) } SpinBox { value: backend.cursorHeight; onValueChanged: backend.setCursorHeight(value) } RowLayout { Button { text: qsTr("Enable"); onClicked: backend.enable() } Button { text: qsTr("Disable"); onClicked: backend.disable() } Button { text: qsTr("Reload"); onClicked: backend.reconfigureSystem() } } } } } }
