# Arch Linux install script hooks for ultralightwebcursor.

post_install() {
    cat <<'EOF'

  Ultralight Web Cursor installed.

  Choose which variant you want to use:
      [1] KWin  (Wayland / KDE Plasma)
      [2] X11   (standalone overlay)

  You can run the selector at any time with:
      ultralightwebcursor-install

EOF
    if [ -t 0 ] && command -v ultralightwebcursor-install >/dev/null 2>&1; then
        ultralightwebcursor-install || true
    fi
}

pre_remove() {
    # Best effort: unregister the X11 autostart entry.
    rm -f "${HOME}/.config/autostart/ultralightwebcursor.desktop" 2>/dev/null || true
}

post_remove() {
    cat <<'EOF'

  Ultralight Web Cursor removed.
  If you were using the KWin variant, you may want to disable the effect in
  System Settings or run:
      busctl --user call org.kde.KWin /Effects org.kde.kwin.Effects unloadEffect s ultralightwebcursor

EOF
}
